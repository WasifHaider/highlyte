# Copy this file to .env and fill in your Supabase project's values.
# Settings -> API in your Supabase project dashboard.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your-service-or-anon-key

# Optional: store cut clips in a Cloudflare R2 bucket instead of local
# disk. R2 dashboard -> Manage R2 API Tokens for the access key pair.
# Leave all unset to keep serving clips from data/clips/ as before.
# R2_ACCOUNT_ID=your-cloudflare-account-id
# R2_ACCESS_KEY_ID=your-r2-access-key-id
# R2_SECRET_ACCESS_KEY=your-r2-secret-access-key
# R2_BUCKET=highlyte-clips
# Optional: only needed if the bucket is public (r2.dev URL, or a custom
# domain mapped to it). Leave unset to serve clips via presigned URLs
# instead (works with a private bucket, no public exposure needed).
# R2_PUBLIC_BASE_URL=https://pub-xxxxxxxx.r2.dev

# Phase 1 rendering: Remotion on AWS Lambda. All five are required to
# enable Export; analysis and the in-browser preview work without them.
# R2 (above) is also required for rendering: Lambda reads each clip's
# source from R2 and the finished mp4 is stored there.
# REMOTION_AWS_ACCESS_KEY_ID=
# REMOTION_AWS_SECRET_ACCESS_KEY=
# REMOTION_AWS_REGION=ap-south-1
# From `npm run deploy:functions` in renderer/ (e.g. remotion-render-4-0-527-mem2048mb-disk2048mb-240sec):
# REMOTION_FUNCTION_NAME=
# From `npm run deploy:site` in renderer/ (the "Serve URL" it prints):
# REMOTION_SERVE_URL=

# Groq (free tier): hosted Whisper for transcripts and per-clip caption
# timing, plus LLM highlight selection. Without it, local Whisper and the
# heuristic scorer are used and captions may be approximately timed.
# GROQ_KEY=

# Set when the app is served over https, so login cookies are only sent over https.
# COOKIE_SECURE=true
