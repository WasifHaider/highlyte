# Copy this file to .env and fill in your Supabase project's values.
# Settings -> API in your Supabase project dashboard.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your-service-or-anon-key

# Optional: enables LLM-backed highlight scoring instead of the built-in
# free heuristic scorer. Leave unset to run fully free/offline.
# OPENAI_API_KEY=

# Optional: store cut clips in a Cloudflare R2 bucket instead of local
# disk. R2 dashboard -> Manage R2 API Tokens for the access key pair.
# Leave all unset to keep serving clips from data/clips/ as before.
# R2_ACCOUNT_ID=your-cloudflare-account-id
# R2_ACCESS_KEY_ID=your-r2-access-key-id
# R2_SECRET_ACCESS_KEY=your-r2-secret-access-key
# R2_BUCKET=highlyte-clips
# Optional: only needed if the bucket is public (r2.dev URL, or a custom
# domain mapped to it). Leave unset to serve clips via presigned URLs
# instead (works with a private bucket, no public exposure needed).
# R2_PUBLIC_BASE_URL=https://pub-xxxxxxxx.r2.dev
